{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "dev": "HTTPS=true vite",
    "build": "vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ci": "npm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "deps:browsers": "npx --yes update-browserslist-db@latest",
    "coverage:clean": "rm -rf coverage coverage-reports",
    "coverage": "npm run coverage:clean && npm run test"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.3.1",
    "@mui/x-tree-view": "^9.9.0",
    "@react-oauth/google": "^0.13.5",
    "@react-spring/web": "^10.1.2",
    "bootstrap": "^5.3.3",
    "clsx": "^2.1.1",
    "crc-32": "^1.2.2",
    "dompurify": "^3.4.13",
    "luxon": "^3.4.4",
    "mammoth": "^1.12.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-bootstrap": "^2.10.2",
    "react-dom": "^19.2.8",
    "react-file-icon": "^1.6.0",
    "react-reader": "^2.0.15",
    "react-router-dom": "^7.18.2",
    "rtf.js": "^3.0.9",
    "sprintf-js": "^1.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "caniuse-lite": "^1.0.30001809",
    "eslint": "^10.7.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "prop-types": "^15.8.1",
    "vite": "^8.2.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.13",
    "lodash": "4.18.1",
    "yaml": "1.10.3",
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
